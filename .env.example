# Необязательно: без .env всё работает со значениями по умолчанию (локальный запуск).
# Свои настройки: cp .env.example .env
APP_VERSION=dev
GHCR_OWNER=local

# БД и брокер (внутри docker compose хосты db / redis)
POSTGRES_USER=leaderhelp
POSTGRES_PASSWORD=leaderhelp
POSTGRES_DB=leaderhelp
DATABASE_URL=postgresql+psycopg://leaderhelp:leaderhelp@db:5432/leaderhelp
REDIS_URL=redis://redis:6379/0

# Режим разработки: 1 - включить (подробнее в compose.override.yaml). На сервере пусто.
DEV_MODE=

# Секрет для подписи входа (JWT) и ссылок. Не задан = значение только для разработки.
# Без DEV_MODE обязателен, 32+ символа: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
# Служебный доступ к /api/v1/admin (заголовок X-Admin-Token). Пусто = выключен.
# Без DEV_MODE: пусто или 32+ символа.
ADMIN_TOKEN=
# Адрес фронтенда (отдельное приложение), которому разрешены запросы из браузера
CORS_ORIGINS=["http://localhost:5173"]
# Адрес фронтенда, из него собираются ссылки в письмах
PUBLIC_BASE_URL=http://localhost:8080

# 1 - загрузить демо-данные (host@example.com / demo1234) в пустую базу, нужен DEV_MODE=1.
DEMO_DATA=
# Адреса команды для демо-участников через запятую (пусто = адреса-заглушки example.com).
DEMO_TEAM_EMAILS=

# LLM (YandexGPT, OpenAI-совместимый API). Пусто -> заглушка с готовыми ответами.
LLM_API_KEY=
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# Пример: gpt://<folder_id>/yandexgpt-lite/latest. Пустая модель при заданном ключе -> заглушка.
LLM_MODEL=

# Почта (Yandex Postbox SMTP). SMTP_HOST пуст -> письма только пишутся в лог.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.com

# Порт API на вашем компьютере (если 8000 занят)
BACKEND_PORT=8000
